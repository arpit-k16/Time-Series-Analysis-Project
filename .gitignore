# ---- Streamlit --------------------------------------------------------
# Runtime logs written by `streamlit run app.py > streamlit.log`
*.log

# Never commit credentials. The theme in .streamlit/config.toml IS committed.
.streamlit/secrets.toml

# ---- Generated data ---------------------------------------------------
# The aggregate cache is derived output, not source. It is rebuilt on demand
# with:  python scripts/build_cache.py
# Keeping ~150 Parquet files out of git history keeps the repo small and the
# clone fast; every file is reproducible from the public NYC Open Data API.
data/processed/
*.parquet

